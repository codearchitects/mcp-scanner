{
  "name": "@codearchitects/mcp-scanner",
  "version": "1.1.2",
  "description": "Scan TypeScript projects for @ExposeTool decorated methods and generate VS Code languageModelTools entries in package.json",
  "repository": {
    "type": "git",
    "url": "https://github.com/codearchitects/mcp-scanner"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-scanner": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vscode": {
      "types": "./dist/vscode/index.d.ts",
      "default": "./dist/vscode/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "vscode": [
        "dist/vscode/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "node -e \"const fs = require('fs'); const path = require('path'); fs.mkdirSync('dist/templates', { recursive: true }); fs.copyFileSync('src/templates/proxy-scaffold.ejs', 'dist/templates/proxy-scaffold.ejs');\"",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:ci": "npm run test:coverage",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "vscode",
    "language-model-tool",
    "typescript",
    "scanner",
    "decorator",
    "copilot"
  ],
  "author": "Code Architects",
  "license": "MIT",
  "dependencies": {
    "ejs": "^3.1.10",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.96.0",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
